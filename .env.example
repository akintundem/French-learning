# Leave these unset for local development — the app falls back to SQLite
# at db/practice.db.
#
# Set both to use Supabase (this is what Vercel needs). Run db/postgres.sql
# and db/functions.sql in the Supabase SQL editor first; the variables alone
# are not enough. See DEPLOY.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, and only for a single-user deployment with no sign-in: this key
# BYPASSES Row Level Security. Never prefix it with NEXT_PUBLIC_, and never
# commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=
